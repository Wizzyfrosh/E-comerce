# ─────────────────────────────────────────────────────────────
# Digitaz — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` (already gitignored).
# ─────────────────────────────────────────────────────────────

# ── Supabase (required for auth + database) ──────────────────
# Project URL, found in Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to expose to the browser (enforced by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SECRET, bypasses RLS. Server-side only.
# Never expose to the browser. Used by admin/server-only scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection string — used to apply migrations and
# seed data with psql. Format: postgresql://user:pass@host:5432/db
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ── Auth providers ───────────────────────────────────────────
# Set to "true" to show the "Sign in with Google" button.
# Requires Google OAuth configured in Supabase → Authentication → Providers.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# Public site origin — used as the base for OAuth / email redirect URLs.
# e.g. http://localhost:3000 in dev, https://digitaz.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (Phase 3 — payments) ──────────────────────────────
# Secret API key — server-side only.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret

# Webhook signing secret — used to verify Stripe webhook events.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Publishable key — safe to expose to the browser (Stripe.js / Elements).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable

# ── Email (Resend — transactional email) ────────────────────
# API key for sending order confirmations, reset emails, etc.
RESEND_API_KEY=re_your-resend-api-key
